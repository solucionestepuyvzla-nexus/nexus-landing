# ==============================================================================
# TEPUY CONDO NEXUS - VARIABLES DE ENTORNO DE PRODUCCIÓN (VPS)
# Copiar este archivo a .env en el VPS: cp .env.prod.example .env
# Generar claves criptográficas seguras con: openssl rand -hex 32
# ==============================================================================

# Entorno
ENVIRONMENT=production

# Base de Datos PostgreSQL 16
POSTGRES_DB=tepuy_condo_db
POSTGRES_USER=tepuy_admin
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_ALFANUMERICO_SEGURO_64_CHARS

# Redis 7
REDIS_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO_REDIS

# Seguridad JWT y HMAC SHA-256 (32 bytes mínimo)
SECRET_KEY=CAMBIAR_POR_OPENSSL_RAND_HEX_32

# Token del Túnel de Cloudflare Zero Trust (Obtenido en Cloudflare One -> Access -> Tunnels)
# Apuntando al Service URL: http://backend:8000
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...
